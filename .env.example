# پورت اجرای سرور
PORT=3000

# محیط اجرا: development | production | test
NODE_ENV=development

# کلید امضای JWT — حتماً در production یک مقدار طولانی و تصادفی جایگزین کنید
JWT_SECRET=shahin-market-dev-secret-change-in-production

# مدت اعتبار توکن دسترسی (کوتاه‌مدت، امنیت بالاتر در برابر سرقت توکن)
JWT_ACCESS_EXPIRES_IN=15m

# مدت اعتبار توکن تازه‌سازی (روز) — در کوکی HttpOnly ذخیره می‌شود
JWT_REFRESH_EXPIRES_DAYS=30

# مدت اعتبار توکن موقت مرحله دوم ورود (2FA)
TEMP_2FA_TOKEN_EXPIRES_IN=5m

# سطح لاگ‌گیری: error | warn | info | http | debug
LOG_LEVEL=info

# مسیر فایل دیتابیس SQLite (نسبت به ریشه پروژه)
DATABASE_FILE=shahin.db

# ===== محدودیت نرخ درخواست (Rate Limiting) =====
# بازه زمانی به دقیقه و حداکثر تعداد درخواست عمومی در آن بازه
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
# حداکثر تلاش ورود/ثبت‌نام در همان بازه (محافظت در برابر Brute-Force)
AUTH_RATE_LIMIT_MAX=8

# ===== سرویس‌های خارجی (فاز بعدی — فعلاً شبیه‌سازی‌شده) =====
# SMS_PROVIDER_API_KEY=
# ZARINPAL_MERCHANT_ID=
